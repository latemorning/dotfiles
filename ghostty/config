# 폰트
font-family = D2Coding
font-size = 14

# 테마
theme = Dracula

# 창 투명도
background-opacity = 0.95

# 창 크기 (시작 시)
window-width = 130
window-height = 40

# 패딩
window-padding-x = 10
window-padding-y = 10

# 커서
cursor-style = block
cursor-style-blink = false

# 스크롤백
scrollback-limit = 10000

# 쉘
shell-integration = zsh

# 탭바 숨기기 (tmux 쓸 거면 불필요)
window-decoration = true

# true color 지원 (tmux에서 색상 깨짐 방지)
term = xterm-256color

# Option 키를 Meta로 (tmux 단축키 활용)
macos-option-as-alt = true
